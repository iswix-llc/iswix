  <!-- The IsWiX project templates ship in the extension as a dotnet new template pack. Visual Studio finds it through
       IsWiXTemplates.pkgdef and lists its templates in the New Project dialog. -->
  <Target Name="PackTemplates" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <TemplatePackDir>$(MSBuildProjectDirectory)\obj\templates</TemplatePackDir>
    </PropertyGroup>
    <RemoveDir Directories="$(TemplatePackDir)" />
    <Exec Command="dotnet pack &quot;$(MSBuildProjectDirectory)\..\Templates\IsWiX.Templates.csproj&quot; -c Release -o &quot;$(TemplatePackDir)&quot; --nologo -v:q" />
    <ItemGroup>
      <VSIXSourceItem Include="$(TemplatePackDir)\*.nupkg" VSIXSubPath="ProjectTemplates\" />
    </ItemGroup>
  </Target>
