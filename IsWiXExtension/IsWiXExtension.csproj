    <Content Include="ProjectSystem\BuildSystem\Rules\*.xaml">
      <IncludeInVSIX>true</IncludeInVSIX>
      <InstallRoot>MSBuild</InstallRoot>
      <VSIXSubPath>IsWiX\Rules</VSIXSubPath>
