<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<Extern href="stdidcmd.h"/>
	<Extern href="vsshlids.h"/>
	<Commands package="guidIsWiXPackage">
		<!-- Neither command is on a menu (CommandWellOnly): opening a .wxs opens the IsWiX editor. They can still be run
		     from the Command Window or bound to keys in Tools > Options > Environment > Keyboard. -->
		<Buttons>
			<!-- Starts the standalone IsWiX app on the active document. -->
			<Button guid="guidIsWiXPackageCmdSet" id="CommandLaunchIsWiXId" priority="0x0100" type="Button">
				<Icon guid="guidImages" id="bmpPic1" />
				<CommandFlag>CommandWellOnly</CommandFlag>
				<Strings>
					<ButtonText>Launch IsWiX</ButtonText>
					<CanonicalName>.IsWiX.Launch</CanonicalName>
					<LocCanonicalName>.IsWiX.Launch</LocCanonicalName>
				</Strings>
			</Button>
			<!-- Opens a .wxs in the IsWiX editor (Design and XML tabs): "IsWiX.OpenDesigner path" in the Command Window. -->
			<Button guid="guidIsWiXPackageCmdSet" id="CommandOpenDesignerId" priority="0x0101" type="Button">
				<Icon guid="guidImages" id="bmpPic1" />
				<CommandFlag>CommandWellOnly</CommandFlag>
				<CommandFlag>AllowParams</CommandFlag>
				<Strings>
					<ButtonText>Open in IsWiX Designer</ButtonText>
					<CanonicalName>.IsWiX.OpenDesigner</CanonicalName>
					<LocCanonicalName>.IsWiX.OpenDesigner</LocCanonicalName>
				</Strings>
			</Button>
		</Buttons>
		<Bitmaps>
			<Bitmap guid="guidImages" href="Resources\CommandLaunchIsWiX.png" usedList="bmpPic1"/>
		</Bitmaps>
	</Commands>
	<Symbols>
		<GuidSymbol name="guidIsWiXPackage" value="{6037b2ce-4508-478c-a49e-c361ca5cba63}" />
		<GuidSymbol name="guidIsWiXPackageCmdSet" value="{d7249160-ca26-47c3-b4c3-b18b4360fefb}">
			<IDSymbol name="CommandLaunchIsWiXId" value="0x0100" />
			<IDSymbol name="CommandOpenDesignerId" value="0x0101" />
		</GuidSymbol>
		<GuidSymbol name="guidImages" value="{61E4BD4D-8F35-441C-8B1E-DF6B4184712F}" >
			<IDSymbol name="bmpPic1" value="1" />
		</GuidSymbol>
	</Symbols>
</CommandTable>
