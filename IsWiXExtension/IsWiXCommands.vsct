<!-- IsWiX's commands: Convert to IsWiX Project / Convert to WiX Project, on project nodes (loaded or unloaded) and
     the solution node. Commands/ConvertCommands.cs decides when each shows. -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidIsWiXPackage">
    <Groups>
      <Group guid="guidIsWiXCommandSet" id="ProjectConvertGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
      <Group guid="guidIsWiXCommandSet" id="SolutionConvertGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertProjectToIsWiX" priority="0x0100" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="ProjectConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert to IsWiX Project</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertProjectToWix" priority="0x0101" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="ProjectConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert to WiX Project</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertSolutionToIsWiX" priority="0x0100" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="SolutionConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert WiX Projects to IsWiX Projects</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertSolutionToWix" priority="0x0101" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="SolutionConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert IsWiX Projects to WiX Projects</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- The project group on unloaded projects too: a .wixproj is unloaded when HeatWave isn't installed. -->
  <CommandPlacements>
    <CommandPlacement guid="guidIsWiXCommandSet" id="ProjectConvertGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_STUBPROJECT" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidIsWiXPackage" value="{6037b2ce-4508-478c-a49e-c361ca5cba63}" />
    <GuidSymbol name="guidIsWiXCommandSet" value="{f9d8589d-bf0e-4b75-ab03-eb3d9cffdc9e}">
      <IDSymbol name="ProjectConvertGroup" value="0x1020" />
      <IDSymbol name="SolutionConvertGroup" value="0x1021" />
      <IDSymbol name="cmdidConvertProjectToIsWiX" value="0x0100" />
      <IDSymbol name="cmdidConvertProjectToWix" value="0x0101" />
      <IDSymbol name="cmdidConvertSolutionToIsWiX" value="0x0102" />
      <IDSymbol name="cmdidConvertSolutionToWix" value="0x0103" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
