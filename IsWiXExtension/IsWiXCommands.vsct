<!-- IsWiX's commands: Convert to IsWiX Project / Convert to WiX Project, on project nodes (loaded or unloaded) and
     the solution node. Commands/ConvertCommands.cs decides when each shows. -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidIsWiXPackage">
    <!-- View > IsWiX Designer Layout: how the .wxs editor shows its Design and XML views. The editor answers these
         (Designer/WixDesignerPane.Layout.cs), so they show only while a .wxs editor is the active document. -->
    <Menus>
      <Menu guid="guidIsWiXCommandSet" id="DesignerLayoutMenu" priority="0x0200" type="Menu">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutMenuGroup" />
        <Strings>
          <ButtonText>IsWiX Designer Layout</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidIsWiXCommandSet" id="DesignerLayoutMenuGroup" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
      <Group guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" priority="0x0100">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutMenu" />
      </Group>
      <Group guid="guidIsWiXCommandSet" id="ProjectConvertGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
      <Group guid="guidIsWiXCommandSet" id="SolutionConvertGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertProjectToIsWiX" priority="0x0100" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="ProjectConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert to IsWiX Project</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertProjectToWix" priority="0x0101" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="ProjectConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert to WiX Project</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertSolutionToIsWiX" priority="0x0100" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="SolutionConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert WiX Projects to IsWiX Projects</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidConvertSolutionToWix" priority="0x0101" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="SolutionConvertGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Convert IsWiX Projects to WiX Projects</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidLayoutHorizontal" priority="0x0100" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>&amp;Horizontal Split (Design above XML)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidLayoutVertical" priority="0x0101" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>&amp;Vertical Split (Design beside XML)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidLayoutCycle" priority="0x0102" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Show &amp;Both, Design or XML View</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidLayoutFloatDesign" priority="0x0105" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Float D&amp;esign View</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidIsWiXCommandSet" id="cmdidLayoutFloatXml" priority="0x0106" type="Button">
        <Parent guid="guidIsWiXCommandSet" id="DesignerLayoutGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Float XM&amp;L View</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidIsWiXCommandSet" id="cmdidLayoutHorizontal" editor="guidWixDesignerEditor" mod1="Alt Shift" key1="1" />
    <KeyBinding guid="guidIsWiXCommandSet" id="cmdidLayoutVertical" editor="guidWixDesignerEditor" mod1="Alt Shift" key1="2" />
    <KeyBinding guid="guidIsWiXCommandSet" id="cmdidLayoutCycle" editor="guidWixDesignerEditor" mod1="Alt Shift" key1="3" />
    <KeyBinding guid="guidIsWiXCommandSet" id="cmdidLayoutFloatDesign" editor="guidWixDesignerEditor" mod1="Alt Shift" key1="4" />
    <KeyBinding guid="guidIsWiXCommandSet" id="cmdidLayoutFloatXml" editor="guidWixDesignerEditor" mod1="Alt Shift" key1="5" />
  </KeyBindings>

  <!-- The project group on unloaded projects too: a .wixproj is unloaded when HeatWave isn't installed. -->
  <CommandPlacements>
    <CommandPlacement guid="guidIsWiXCommandSet" id="ProjectConvertGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_STUBPROJECT" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidIsWiXPackage" value="{6037b2ce-4508-478c-a49e-c361ca5cba63}" />
    <GuidSymbol name="guidIsWiXCommandSet" value="{f9d8589d-bf0e-4b75-ab03-eb3d9cffdc9e}">
      <IDSymbol name="ProjectConvertGroup" value="0x1020" />
      <IDSymbol name="SolutionConvertGroup" value="0x1021" />
      <IDSymbol name="cmdidConvertProjectToIsWiX" value="0x0100" />
      <IDSymbol name="cmdidConvertProjectToWix" value="0x0101" />
      <IDSymbol name="cmdidConvertSolutionToIsWiX" value="0x0102" />
      <IDSymbol name="cmdidConvertSolutionToWix" value="0x0103" />
      <IDSymbol name="DesignerLayoutMenuGroup" value="0x1030" />
      <IDSymbol name="DesignerLayoutMenu" value="0x1031" />
      <IDSymbol name="DesignerLayoutGroup" value="0x1032" />
      <IDSymbol name="cmdidLayoutHorizontal" value="0x0110" />
      <IDSymbol name="cmdidLayoutVertical" value="0x0111" />
      <IDSymbol name="cmdidLayoutCycle" value="0x0112" />
      <IDSymbol name="cmdidLayoutFloatDesign" value="0x0115" />
      <IDSymbol name="cmdidLayoutFloatXml" value="0x0116" />
    </GuidSymbol>
    <!-- The .wxs editor (Designer/WixDesignerEditorFactory.cs): the shortcuts apply while it is the active editor. -->
    <GuidSymbol name="guidWixDesignerEditor" value="{2c930e52-76a4-4f4d-b21d-e231228d788c}" />
  </Symbols>
</CommandTable>
