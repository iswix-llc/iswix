<!-- A package version from central package management (Directory.Packages.props). -->
<Rule Name="PackageVersion" DisplayName="Package Version" PageTemplate="generic" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="false" ItemType="PackageVersion" />
  </Rule.DataSource>
  <StringProperty Name="Version" Visible="false" />
  <StringProperty Name="IsImplicitlyDefined" ReadOnly="true" Visible="false" />
</Rule>
