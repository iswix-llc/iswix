<!-- A package NuGet downloads without referencing it. -->
<Rule Name="PackageDownload" DisplayName="Package Download" PageTemplate="generic" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="false" ItemType="PackageDownload" />
  </Rule.DataSource>
  <StringProperty Name="Version" Visible="false" />
  <StringProperty Name="IsImplicitlyDefined" ReadOnly="true" Visible="false" />
</Rule>
