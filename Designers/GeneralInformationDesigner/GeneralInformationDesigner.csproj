<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>
	  <Private>false</Private>
	  <EnableDynamicLoading>true</EnableDynamicLoading>
	  <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="GeneralInformation.ico" />
    <None Remove="GeneralInformation.dark.ico" />
    <None Remove="License.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GeneralInformation.ico" />
    <!-- The designer list's icon in Visual Studio's dark themes. -->
    <EmbeddedResource Include="GeneralInformation.dark.ico" />
    <EmbeddedResource Include="License.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
  </ItemGroup>
	<ItemGroup>
		<!-- FireworksFramework also brings IsWiX.WiXModel, so every designer uses the same version. -->
		<ProjectReference Include="..\..\Shared\FireworksFramework\FireworksFramework.csproj" />
	</ItemGroup>

</Project>
