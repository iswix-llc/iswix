<UserControl x:Class="GeneralInformationDesigner.Views.GeneralInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmmodels="clr-namespace:GeneralInformationDesigner.ViewModels"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local="clr-namespace:GeneralInformationDesigner.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmmodels:GeneralInformationViewModel}">
    <Grid Margin="3,0,-3,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
        <!-- The border marks the grid whose element the XML editor's caret is in. -->
        <Border Grid.Column="0" x:Name="borderPackage4" BorderThickness="2" BorderBrush="Transparent" VerticalAlignment="Top">
            <xctk:PropertyGrid x:Name="propertyGridPackage4" SelectedObject="{Binding Package4}" Visibility="{Binding Package4PropertyGridVisible}" ShowSortOptions="False" IsCategorized="False" ShowSearchBox="false" Height="500" GotKeyboardFocus="PropertyGrid_GotKeyboardFocus" SelectedPropertyItemChanged="PropertyGrid_SelectedPropertyItemChanged"/>
        </Border>
        <Border Grid.Column="2" x:Name="borderSummaryInformation" BorderThickness="2" BorderBrush="Transparent" VerticalAlignment="Top">
            <xctk:PropertyGrid x:Name="propertyGridSummaryInformation" SelectedObject="{Binding SummaryInformation4, Mode=TwoWay}" Visibility="{Binding SummaryInformation4PropertyGridVisible}" ShowSortOptions="False" IsCategorized="False" ShowSearchBox="false" Height="500" GotKeyboardFocus="PropertyGrid_GotKeyboardFocus" SelectedPropertyItemChanged="PropertyGrid_SelectedPropertyItemChanged"></xctk:PropertyGrid>
        </Border>
    </Grid>
</UserControl>
